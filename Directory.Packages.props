<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.1" />
    <PackageVersion Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
    <PackageVersion Include="Amazon.Lambda.Core" Version="3.3.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <!-- Analyzer-author rules (RS****) for SliceFx.SourceGenerator, build-time only.
         PrivateAssets="all", contributes no runtime API, so unlike the two
         CodeAnalysis entries below this is NOT part of the consumer Roslyn floor. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <!-- Version-forcing pin, not a consumed dependency. Nothing here calls the Microsoft.OpenApi
         API; it arrives transitively via Microsoft.AspNetCore.OpenApi, which still asks for the
         vulnerable 2.0.0, and NuGet's nearest-wins resolution keeps it there. The lone direct
         PackageReference (samples/SliceFx.Sample) exists only to override that, patching
         GHSA-v5pm-xwqc-g5wc (stack-overflow DoS on circular schema refs).

         Stay on the newest 2.x. Do NOT take 3.x until Microsoft.AspNetCore.OpenApi's own
         Microsoft.OpenApi dependency moves past 2.x: it ships an XML-comment source generator
         whose emitted code assigns IOpenApiMediaType.Example, which 3.x made read-only, so 3.x
         fails to build inside Microsoft's generated code where we cannot patch it. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <!-- The consumer Roslyn floor. CSharp is what SliceFx.SourceGenerator compiles
         against, so it sets the minimum Roslyn a consumer's compiler must provide.
         Workspaces is that same floor seen from the IDE side: the code fix project
         compiles against it and ships inside the generator package under
         analyzers/dotnet/cs, while the Workspaces assembly itself comes from the
         IDE host at runtime. Raise either only when intentionally dropping support
         for older SDKs. See .github/dependabot.yml ignore. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="MSBuild.StructuredLogger" Version="2.3.213" />
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
